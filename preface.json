olumn":1}},"children":[{"type":"text","value":"The book is organized in five parts.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"mOkxzegdCG"}],"key":"ojfsXTfD2j"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":35,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Part I, Foundations (Chapters 1–3).","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"vBbckTaCGk"}],"key":"C9VR69ogAI"},{"type":"text","value":" What machine learning is, how to set up your environment, the Python and probability tools used throughout, and statistical learning theory, the framework that tells us what it means for a model to learn and to generalize.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"PsIHbIQbHX"}],"key":"TOIcZZji1r"}],"key":"Xj7X6Eg2JH"},{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Part II, Classical Supervised Learning (Chapters 4–11).","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"I8TtDVSR6k"}],"key":"hkmaer7lLe"},{"type":"text","value":" Nearest-neighbor methods and the bias–variance trade-off, cross-validation and hyperparameter tuning, regularized least squares and logistic regression, stochastic gradient descent, support vector machines, kernels and the representer theorem, sparsity and feature selection (OMP, Lasso, Elastic Net), and decision trees and ensembles.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"aKhXWFouWX"}],"key":"UfGG2Pjasr"}],"key":"OeWwkaQhG1"},{"type":"listItem","spread":true,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Part III, Unsupervised Learning (Chapters 12–13).","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"sDMYWkYciR"}],"key":"Q2x0LjRDlj"},{"type":"text","value":" Clustering (k-means, vector quantization, spectral clustering, and how to choose the number of clusters), and dimensionality reduction with SVD, PCA, and kernel PCA.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"hQWhjLy0iR"}],"key":"ath6B04Ozy"}],"key":"lIp3X5MAkt"},{"type":"listItem","spread":true,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Part IV, Deep Learning (Chapters 14–21).","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"wckCV6X9gY"}],"key":"wtU5MKEJb2"},{"type":"text","value":" Neural network fundamentals, backpropagation and the practice of training deep networks, convolutional networks and their applications, recurrent networks (RNN, LSTM, GRU), attention and transformers, autoencoders and GANs, and graph neural networks.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"KZvBW9RCXK"}],"key":"gwPP33zvrW"}],"key":"iWSi8tqqgW"},{"type":"listItem","spread":true,"position":{"start":{"line":39,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Part V, Decisions and Modern AI (Chapters 22–23).","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"aJs7ei0ZcM"}],"key":"ttJnQidzw6"},{"type":"text","value":" Reinforcement learning with Markov decision processes, Monte Carlo methods, and temporal-difference learning, followed by large language models, modern architectures, AI agents, and future directions.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"GetRT6Kajk"}],"key":"MXRp8MVEBn"}],"key":"tFh1PTrhXi"}],"key":"VHmruZBTsF"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"The book closes with conclusions, appendices (a math cheat sheet, a Python cheat sheet, solutions to the exercises, and a glossary), and a bibliography.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"Yjblz8isc8"}],"key":"nqG96UCZnK"},{"type":"heading","depth":2,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Suggested reading paths","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"MCHt2hN5qm"}],"identifier":"suggested-reading-paths","label":"Suggested reading paths","html_id":"suggested-reading-paths","implicit":true,"key":"tGQBgcpPjG"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"If you are following a full course, read the chapters in order: each one builds on the previous ones. If your main interest is deep learning, a faster route is to read Chapters 1–3 and 5–7, which introduce the setup, the learning framework, evaluation, linear models, and gradient-based optimization, and then to move to Part IV, returning to the classical methods later. In either case, do the exercises: the notebooks are designed to be changed and re-run, and that is where most of the learning happens.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"YTk2S3u3t9"}],"key":"wbcYc1Xsal"},{"type":"heading","depth":2,"position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"A note on rigor","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"NDy2LXN20Y"}],"identifier":"a-note-on-rigor","label":"A note on rigor","html_id":"a-note-on-rigor","implicit":true,"key":"o16RQdKDAY"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"The book aims to be mathematically honest without being heavy. When a result is stated without proof, the text says so and indicates where to find the proof, and the bibliography collects references for readers who want to go further. When a simplification is made for the sake of clarity, it is flagged as such.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"hWhAgRjxje"}],"key":"tksaWRZ5MC"},{"type":"heading","depth":2,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Acknowledgments","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"RNHeNDtqjW"}],"identifier":"acknowledgments","label":"Acknowledgments","html_id":"acknowledgments","implicit":true,"key":"aQb8POkFc8"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"This book would not exist without the open-source community. The code is written in Python and runs in Jupyter notebooks. The book is built with Jupyter Book, a project of the Executable Books community. The numerical and learning code relies on NumPy, SciPy, pandas, matplotlib, seaborn, scikit-learn, and PyTorch, including its torchvision and torchaudio libraries. Thanks go to the maintainers and contributors of all these projects, and to the researchers and institutions who created and released the open datasets used in the examples; each dataset is cited where it appears.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"mnuq3rx6N2"}],"key":"vHntcT5tub"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"Mario Medone\n2026","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"ffNeEXhcnY"}],"key":"rjoFWJjsEr"}],"key":"QwiFOEXUXm"}],"key":"ygWnMLXWhs"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Copyright and Editorial Information","url":"/copyright","group":"Machine Learning with Python: From Linear Algebra to Deep Learning"},"next":{"title":"How to Use This Book","url":"/how-to-use","group":"Machine Learning with Python: From Linear Algebra to Deep Learning"}}},"domain":"http://pre.render"}